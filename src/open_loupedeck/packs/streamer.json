{
  "id": "streamer",
  "name_key": "pack.streamer.name",
  "description_key": "pack.streamer.desc",
  "icon": "lucide:radio",
  "services": ["obs", "twitch"],
  "grid": [5, 3],
  "pages": [
    {
      "controls": {
        "key_1_0": {"action": {"type": "obs.set_scene", "scene": "Game"}, "background": "#1f6fe0", "text_color": "#ffffff"},
        "key_2_0": {"action": {"type": "obs.set_scene", "scene": "Chat"}, "background": "#0e8fa3", "text_color": "#ffffff"},
        "key_3_0": {"action": {"type": "obs.set_scene", "scene": "Cam"}, "background": "#2e9b47", "text_color": "#ffffff"},
        "key_4_0": {"action": {"type": "obs.set_scene", "scene": "Desk"}, "background": "#b8941a", "text_color": "#ffffff"},
        "key_1_1": {"action": {"type": "obs.set_scene", "scene": "BRB"}, "background": "#d9822b", "text_color": "#ffffff"},
        "key_2_1": {"action": {"type": "obs.set_scene", "scene": "Ending"}, "text_key": "pack.streamer.key.end", "background": "#c2562a", "text_color": "#ffffff"},
        "key_3_1": {"action": {"type": "obs.toggle_mute", "input_name": "Mic/Aux"}, "text_key": "pack.streamer.key.mic"},
        "key_4_1": {"action": {"type": "display.twitch_live", "login": ""}},
        "key_0_2": {"action": {"type": "display.obs_scene"}},
        "key_4_2": {"action": {"type": "display.clock", "time_format": "%H:%M", "date_format": "%a %d %b"}},
        "knob_0": {"rotate": {"duo": "system_volume", "params": {"step": 5}}, "press": {"type": "sound.mute_toggle"}},
        "knob_1": {"rotate": {"duo": "obs_scene"}}
      }
    }
  ]
}
