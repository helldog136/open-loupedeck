{
  "id": "smart_home",
  "name_key": "pack.smart_home.name",
  "description_key": "pack.smart_home.desc",
  "icon": "lucide:lightbulb",
  "services": ["ha"],
  "grid": [5, 3],
  "pages": [
    {
      "controls": {
        "key_1_0": {"action": {"type": "ha.toggle", "entity_id": "light.living_room"}, "text_key": "pack.smart_home.key.living_room"},
        "key_2_0": {"action": {"type": "ha.toggle", "entity_id": "light.bedroom"}, "text_key": "pack.smart_home.key.bedroom"},
        "key_3_0": {"action": {"type": "ha.toggle", "entity_id": "light.kitchen"}, "text_key": "pack.smart_home.key.kitchen"},
        "key_4_0": {"action": {"type": "ha.toggle", "entity_id": "light.office"}, "text_key": "pack.smart_home.key.office"},
        "key_4_2": {"action": {"type": "display.clock", "time_format": "%H:%M", "date_format": "%a %d %b"}},
        "knob_0": {"rotate": {"duo": "ha_light_brightness", "params": {"entity_id": "light.living_room", "step": 10}}}
      }
    }
  ]
}
